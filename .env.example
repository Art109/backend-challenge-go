# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=backend_challenge
POSTGRES_PORT=5432

# Keycloak admin console (not used by the app itself at runtime)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081

# LocalStack (SQS)
AWS_REGION=us-east-1
LOCALSTACK_PORT=4566

# Published port for the api service
API_PORT=8080

# Dashboard (optional differentiator): Prometheus + Grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
